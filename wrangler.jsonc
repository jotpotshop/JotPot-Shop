{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jotpot-shop",
  "compatibility_date": "2024-09-23",
  "main": "functions/worker.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
