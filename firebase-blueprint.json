{
  "entities": {
    "BrandingSettings": {
      "title": "BrandingSettings",
      "description": "Website logo, branding assets, contact details and store identity settings",
      "type": "object",
      "properties": {
        "storeName": { "type": "string" },
        "storeNameBn": { "type": "string" },
        "tagline": { "type": "string" },
        "taglineBn": { "type": "string" },
        "logoUrl": { "type": "string" },
        "mobileLogoUrl": { "type": "string" },
        "faviconUrl": { "type": "string" },
        "logoStoragePath": { "type": "string" },
        "updatedAt": { "type": "string" },
        "updatedBy": { "type": "string" }
      },
      "required": ["storeName", "logoUrl"]
    },
    "HelpCenterSettings": {
      "title": "HelpCenterSettings",
      "description": "Super Admin managed Customer Support, FAQs, and Contact Channels",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "titleBn": { "type": "string" },
        "subtitle": { "type": "string" },
        "subtitleBn": { "type": "string" },
        "supportEmail": { "type": "string" },
        "supportPhone": { "type": "string" },
        "businessHoursBn": { "type": "string" }
      },
      "required": ["title", "titleBn", "supportPhone"]
    },
    "TrustSectionSettings": {
      "title": "TrustSectionSettings",
      "description": "Editable trust section headings, cards and badges displayed on storefront",
      "type": "object",
      "properties": {
        "sectionTitleBn": { "type": "string" },
        "sectionSubtitleBn": { "type": "string" },
        "items": { "type": "array" },
        "updatedAt": { "type": "string" }
      }
    },
    "UnifiedConversation": {
      "title": "UnifiedConversation",
      "description": "Customer live chat and omnichannel support conversation thread",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "customerUid": { "type": "string" },
        "channel": { "type": "string" },
        "customerName": { "type": "string" },
        "customerPhone": { "type": "string" },
        "lastMessage": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "channel", "customerName", "lastMessage", "status"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer order details, items, delivery address, and lifecycle tracking",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "customerUid": { "type": "string" },
        "customerName": { "type": "string" },
        "phone": { "type": "string" },
        "items": { "type": "array" },
        "totalAmount": { "type": "number" },
        "status": { "type": "string" },
        "orderDate": { "type": "string" }
      },
      "required": ["id", "customerName", "phone", "totalAmount", "status"]
    },
    "Product": {
      "title": "Product",
      "description": "E-commerce product catalog item with rich description, variants and visibility flag",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "nameBn": { "type": "string" },
        "price": { "type": "number" },
        "category": { "type": "string" },
        "stock": { "type": "number" },
        "isPublished": { "type": "boolean" }
      },
      "required": ["id", "name", "price", "stock"]
    },
    "Customer": {
      "title": "Customer",
      "description": "Registered customer profile (no plaintext passwords stored)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "Staff": {
      "title": "Staff",
      "description": "Staff RBAC record synced from Firebase Auth UID (no plaintext passwords stored)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string" },
        "isActive": { "type": "boolean" }
      },
      "required": ["id", "email", "role"]
    },
    "Coupon": {
      "title": "Coupon",
      "description": "Promotional discount coupon configuration",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "discountValue": { "type": "number" },
        "isActive": { "type": "boolean" }
      },
      "required": ["id", "code"]
    },
    "Bundle": {
      "title": "Bundle",
      "description": "Combo bundle offer configuration",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "bundlePrice": { "type": "number" }
      },
      "required": ["id", "title"]
    },
    "MediaAsset": {
      "title": "MediaAsset",
      "description": "Cloudflare R2 stored file metadata record persisted in Firestore",
      "type": "object",
      "properties": {
        "fileId": { "type": "string" },
        "fileName": { "type": "string" },
        "objectKey": { "type": "string" },
        "publicUrl": { "type": "string" },
        "thumbnailKey": { "type": "string" },
        "thumbnailUrl": { "type": "string" },
        "contentType": { "type": "string" },
        "fileSize": { "type": "number" },
        "width": { "type": "number" },
        "height": { "type": "number" },
        "folder": { "type": "string" },
        "entityId": { "type": "string" },
        "visibility": { "type": "string" },
        "storageBackend": { "type": "string" },
        "uploadedByUid": { "type": "string" },
        "uploadedByEmail": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["fileId", "objectKey", "publicUrl", "contentType", "fileSize", "folder", "visibility"]
    },
    "ConnectionTest": {
      "title": "ConnectionTest",
      "description": "Health check document for testing Firestore connectivity",
      "type": "object",
      "properties": {
        "status": { "type": "string" },
        "timestamp": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/settings/{settingId}": {
      "schema": "BrandingSettings",
      "description": "Storefront configuration (public non-PII allowlist) and staff-restricted operational ledgers"
    },
    "/conversations/{convId}": {
      "schema": "UnifiedConversation",
      "description": "Customer live chat and omnichannel messages isolated per customerUid"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Store orders isolated per customerUid with staff-only status management"
    },
    "/products/{productId}": {
      "schema": "Product",
      "description": "Store inventory and catalog items"
    },
    "/customers/{customerId}": {
      "schema": "Customer",
      "description": "Registered customer profiles isolated per Firebase Auth UID"
    },
    "/staff/{staffId}": {
      "schema": "Staff",
      "description": "Staff RBAC directory keyed by Firebase Auth UID"
    },
    "/coupons/{couponId}": {
      "schema": "Coupon",
      "description": "Storefront discount coupons"
    },
    "/bundles/{bundleId}": {
      "schema": "Bundle",
      "description": "Combo bundle product offers"
    },
    "/media_assets/{fileId}": {
      "schema": "MediaAsset",
      "description": "Cloudflare R2 file metadata registry linked to products, categories, branding, banners, and support uploads"
    },
    "/test/{docId}": {
      "schema": "ConnectionTest",
      "description": "Diagnostics and connectivity test"
    }
  }
}
